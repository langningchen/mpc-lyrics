<UserControl
    x:Class="MpcLyrics.UI.TextStyleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="640" Spacing="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ToggleSwitch
                x:Name="HideWhenEmptyToggle"
                Grid.Column="1"
                Margin="0,0,18,0"
                Header="在空的时候隐藏"
                OffContent="保留位置"
                OnContent="隐藏区域"
                Toggled="HideWhenEmptyToggle_Toggled" />
            <ToggleSwitch
                x:Name="EnabledToggle"
                Grid.Column="2"
                OffContent="隐藏"
                OnContent="显示"
                Toggled="EnabledToggle_Toggled" />
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="FontSizeBox"
                Header="字号"
                IsTabStop="False"
                Maximum="160"
                Minimum="6"
                SpinButtonPlacementMode="Compact"
                ValueChanged="FontSizeBox_ValueChanged" />
            <NumberBox
                x:Name="OutlineWidthBox"
                Grid.Column="1"
                Header="描边"
                IsTabStop="False"
                Maximum="12"
                Minimum="0"
                SmallChange="0.2"
                SpinButtonPlacementMode="Compact"
                ValueChanged="OutlineWidthBox_ValueChanged" />
            <StackPanel
                Grid.Column="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Bottom">
                <ToggleButton x:Name="BoldButton" Width="42" Height="42" Click="BoldButton_Click" ToolTipService.ToolTip="粗体">
                    <FontIcon FontSize="17" Glyph="&#xE8DD;" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Width="42" Height="42" Click="ItalicButton_Click" ToolTipService.ToolTip="斜体">
                    <FontIcon FontSize="17" Glyph="&#xE8DB;" />
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton x:Name="AlignLeftButton" Width="42" Height="42" CornerRadius="4,0,0,4" Click="AlignLeftButton_Click" ToolTipService.ToolTip="左对齐">
                        <FontIcon FontSize="16" Glyph="&#xE8E4;" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignCenterButton" Width="42" Height="42" CornerRadius="0" Click="AlignCenterButton_Click" ToolTipService.ToolTip="居中对齐">
                        <FontIcon FontSize="16" Glyph="&#xE8E3;" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignRightButton" Width="42" Height="42" CornerRadius="0" Click="AlignRightButton_Click" ToolTipService.ToolTip="右对齐">
                        <FontIcon FontSize="16" Glyph="&#xE8E2;" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignJustifyButton" Width="42" Height="42" CornerRadius="0,4,4,0" Click="AlignJustifyButton_Click" ToolTipService.ToolTip="两侧对齐">
                        <PathIcon Width="16" Height="16" Data="M1,1 L15,1 L15,2.5 L1,2.5 Z M1,5 L15,5 L15,6.5 L1,6.5 Z M1,9 L15,9 L15,10.5 L1,10.5 Z M1,13 L15,13 L15,14.5 L1,14.5 Z" />
                    </ToggleButton>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Width="300" HorizontalAlignment="Left" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="描边颜色" />
                <ComboBox
                    x:Name="OutlineColorModeCombo"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OutlineColorModeCombo_SelectionChanged">
                    <ComboBoxItem Content="自定义" />
                    <ComboBoxItem Content="系统主题色" />
                </ComboBox>
                <Grid Width="300">
                    <ColorPicker
                        x:Name="OutlineColorPicker"
                        Width="300"
                        ColorChanged="OutlineColorPicker_ColorChanged"
                        IsAlphaEnabled="False"
                        IsAlphaTextInputVisible="False"
                        IsColorChannelTextInputVisible="False"
                        IsColorPreviewVisible="False" />
                    <Border
                        x:Name="OutlineColorPreview"
                        Width="96"
                        Height="32"
                        Margin="0,0,14,16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        ToolTipService.ToolTip="当前描边颜色" />
                </Grid>
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" />
                    <TextBlock x:Name="OutlineOpacityValue" Grid.Column="1" />
                    <Slider
                        x:Name="OutlineOpacitySlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OutlineOpacitySlider_ValueChanged" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Width="300" HorizontalAlignment="Right" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="填充颜色" />
                <ComboBox
                    x:Name="FillColorModeCombo"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="FillColorModeCombo_SelectionChanged">
                    <ComboBoxItem Content="自定义" />
                    <ComboBoxItem Content="系统主题色" />
                </ComboBox>
                <Grid Width="300">
                    <ColorPicker
                        x:Name="FillColorPicker"
                        Width="300"
                        ColorChanged="FillColorPicker_ColorChanged"
                        IsAlphaEnabled="False"
                        IsAlphaTextInputVisible="False"
                        IsColorChannelTextInputVisible="False"
                        IsColorPreviewVisible="False" />
                    <Border
                        x:Name="FillColorPreview"
                        Width="96"
                        Height="32"
                        Margin="0,0,14,16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        ToolTipService.ToolTip="当前填充颜色" />
                </Grid>
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" />
                    <TextBlock x:Name="FillOpacityValue" Grid.Column="1" />
                    <Slider
                        x:Name="FillOpacitySlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="FillOpacitySlider_ValueChanged" />
                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
